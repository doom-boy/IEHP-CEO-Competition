if ffile:
    f = csv(ffile)
    f.columns = f.columns.str.strip()

    id_col = next(
        (c for c in ["NPI", "npi", "Provider NPI"] if c in f),
        None
    )

    zip_col = next(
        (c for c in ["ZIP", "Zip", "Zip Code", "ZIP Code"]
         if c in f),
        None
    )

    county_col = next(
        (c for c in ["CountyName", "County", "county"]
         if c in f),
        None
    )

    if id_col and zip_col and county_col:
        f["npi"] = f[id_col].map(npi)
        f["zip"] = zip5(f[zip_col])

        f["county"] = (
            f[county_col].astype(str).str.upper()
            .str.replace(" COUNTY", "", regex=False)
            .str.strip().map(COUNTIES)
        )

        f = f[
            f.npi.map(valid_npi)
            & f.county.notna()
            & f.zip.str.fullmatch(r"\d{5}")
        ].copy()

        dental = (
            f.groupby(["county", "zip"], as_index=False)
            .npi.nunique()
            .rename(columns={"npi": "ffs_npis"})
        )

        dental["service"] = "Dental (Source F)"

        dental.to_csv(
            OUT / "08_F_dental_by_ZIP.csv",
            index=False
        )

        if access is not None:
            index = demand[
                ["county", "zip"]
            ].drop_duplicates()

            dacc = index.merge(
                dental,
                on=["county", "zip"],
                how="left"
            )

            dacc["service"] = "Dental (Source F)"
            dacc["ffs_npis"] = (
                dacc.ffs_npis.fillna(0).astype(int)
            )

            dacc = dacc.merge(
                demand[[
                    "county", "zip",
                    "medi_cal_members_est", "month"
                ]],
                on=["county", "zip"],
                how="left"
            )

            dacc["ffs_sites"] = pd.NA

            dacc["providers_per_1000"] = (
                1000 * dacc.ffs_npis /
                dacc.medi_cal_members_est
            )

            dacc["zero_ffs_listed"] = (
                dacc.ffs_npis.eq(0)
            )

            dacc["usable_for_ranking"] = (
                dacc.medi_cal_members_est.gt(0)
            )

            dacc = dacc.sort_values(
                [
                    "zero_ffs_listed",
                    "providers_per_1000",
                    "medi_cal_members_est"
                ],
                ascending=[False, True, False],
                na_position="last"
            )

            dacc["risk_rank"] = pd.NA

            dacc.loc[
                dacc.usable_for_ranking, "risk_rank"
            ] = range(
                1, int(dacc.usable_for_ranking.sum()) + 1
            )

            access = pd.concat(
                [access, dacc[access.columns]],
                ignore_index=True
            )

            access.to_csv(
                OUT / "06_ACCESS_per_1000_and_ranking.csv",
                index=False
            )

            (
                access[access.usable_for_ranking]
                .groupby("service", group_keys=False)
                .head(10)
                .to_csv(
                    OUT / "07_TOP10_access_gaps.csv",
                    index=False
                )
            )

        status(
            "F",
            f"READY: {f.npi.nunique():,} valid dental NPIs."
        )

    else:
        f.to_csv(
            OUT / "08_F_dental_raw_for_review.csv",
            index=False
        )
        status(
            "F",
            "REVIEW: Dental columns need manual verification."
        )

else:
    status(
        "F",
        "MISSING: Dental analysis needs Source F."
    )

