        ("Both IEHP and local FFS", len(iehp & local_ffs)),
        ("Local FFS no match in supplied IEHP PDF",
         len(local_ffs - iehp)),
        ("IEHP no match in local FFS",
         len(iehp - local_ffs)),
        ("IEHP no match in FFS statewide",
         len(iehp - e_all_npis))
    ], columns=["metric", "count"])

    overlap.to_csv(
        OUT / "04_provider_overlap_numbers.csv",
        index=False
    )

    status(
        "I",
        f"READY: {len(iehp & local_ffs):,} IEHP NPIs "
        "match local FFS"
    )

else:
    status(
        "I",
        "MISSING: Add extracted IEHP directory CSV "
        "to calculate overlap"
    )

# ============================================================
# 4. SOURCES A + H — MEDI-CAL MEMBERS BY ZIP
# ============================================================

afile = pick("A", [
    "**/calendar-years-2020-to-the-most-recent-reportable-month.csv"
])

hfile = pick("H", [
    "**/ZIP-COUNTY_062026.xlsx",
    "**/ZIP-COUNTY*.csv",
    "**/ZIP-COUNTY*.xlsx"
])

access = None

if afile and hfile:
    a = csv(afile)

    required_a = {
        "Month of Eligibility", "Zip Code",
        "Sex", "Total Eligibles"
    }

    if required_a - set(a):
        raise ValueError(
            "Source A missing: " + str(required_a - set(a))
        )

    month = next(
        (m for m in ["2026-09", "2026-08"]
         if m in set(a["Month of Eligibility"])),
        None
    )

    if not month:
        raise ValueError(
            "Source A needs August or September 2026."
        )

    a = a[a["Month of Eligibility"].eq(month)].copy()

    a["zip"] = zip5(a["Zip Code"])
    a = a[a.zip.str.fullmatch(r"\d{5}")]

    a["sex"] = a.Sex.str.lower().str.strip().map({
        "male": "male",
        "m": "male",
        "female": "female",
        "f": "female",
        "total": "total",
        "t": "total"
    })

    a["value"] = numeric(a["Total Eligibles"])

    if a.duplicated(["zip", "sex"]).any():
        raise ValueError(
            "Duplicate ZIP/sex rows in Source A. Review first."
        )

    a = a.pivot(
        index="zip", columns="sex", values="value"
    )

    for c in ["male", "female", "total"]:
        if c not in a:
            a[c] = float("nan")

    both = a.male + a.female

    conflicts = (
        both.notna()
        & a.total.notna()
        & both.ne(a.total)
    )

    a["members"] = both.combine_first(a.total)
    a.loc[conflicts, "members"] = float("nan")

    a = a.reset_index()[["zip", "members"]]

    # Source H geographic crosswalk
    if hfile.suffix.lower() in [".xlsx", ".xls"]:
        h = pd.read_excel(hfile, dtype=str)
    else:
        h = csv(hfile)

    h.columns = h.columns.astype(str).str.lower().str.strip()

    if not {"zip", "geoid", "res_ratio"}.issubset(h):
        raise ValueError(
            "Source H needs zip, geoid and res_ratio."
        )

    h["zip"] = zip5(h["zip"])

    h["geoid"] = (
        h.geoid.astype(str)
        .str.replace(r"\.0$", "", regex=True)
        .str.zfill(5)
    )

    h["ratio"] = pd.to_numeric(
        h.res_ratio, errors="coerce"
    )

    h = h[
        h.geoid.isin(FIPS)
        & h.ratio.gt(0)
        & h.ratio.le(1)
    ].copy()

    if h.duplicated(["zip", "geoid"]).any():
        raise ValueError(
            "Duplicate Source H ZIP/county rows."
        )

    h["county"] = h.geoid.map(FIPS)

    demand = h[["county", "zip", "ratio"]].merge(
        a, on="zip", how="left", validate="many_to_one"
    )

    demand["medi_cal_members_est"] = (
        demand.members * demand.ratio
    )

    demand["month"] = month

    demand[[
        "county", "zip", "ratio",
        "medi_cal_members_est", "month"
    ]].to_csv(
        OUT / "05_A_H_members_by_ZIP.csv",
        index=False
    )

    # Include demand ZIPs with zero FFS providers.
    services = sorted(
        set(supply.service) -
        {"Dental (E; use F for complete dental)"}
    )

    index = demand[["county", "zip"]].merge(
        pd.DataFrame({"service": services}),
        how="cross"
    )

    access = index.merge(
        supply,
        on=["county", "zip", "service"],
        how="left",
        validate="one_to_one"
    )

    access["ffs_npis"] = (
        access.ffs_npis.fillna(0).astype(int)
    )

    access = access.merge(
        demand[[
            "county", "zip",
            "medi_cal_members_est", "month"
        ]],
        on=["county", "zip"],
        how="left",
        validate="many_to_one"
    )

    access["providers_per_1000"] = (
        1000 * access.ffs_npis /
        access.medi_cal_members_est
    )

    access["zero_ffs_listed"] = (
        access.ffs_npis.eq(0)
    )

    access["usable_for_ranking"] = (
        access.medi_cal_members_est.gt(0)
    )

    access = access.sort_values(
        [
            "service",
            "zero_ffs_listed",
            "providers_per_1000",
            "medi_cal_members_est"
        ],
        ascending=[True, False, True, False],
        na_position="last"
    )

    access["risk_rank"] = (
        access[access.usable_for_ranking]
        .groupby("service").cumcount() + 1
    )

    access.to_csv(
        OUT / "06_ACCESS_per_1000_and_ranking.csv",
        index=False
    )

    (
        access[access.usable_for_ranking]
        .groupby("service", group_keys=False)
        .head(10)
        .to_csv(
            OUT / "07_TOP10_access_gaps.csv",
            index=False
        )
    )

    status(
        "A+H",
        f"READY: {month}. Access rankings calculated."
    )

else:
    status(
        "A+H",
        "MISSING: Add Sources A and H for "
        "providers-per-1,000 and access rankings."
    )

