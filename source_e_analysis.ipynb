from pathlib import Path
import re
import pandas as pd
from IPython.display import display

# 1. SETTINGS
ROOT = Path(globals().get("repo_root", Path.cwd()))
OUT = ROOT / "analysis_outputs" / "IEHP_FINAL_DASHBOARD"
OUT.mkdir(parents=True, exist_ok=True)

# If automatic detection misses a file, paste its path here.
FILES = {
    "A": None,
    "H": None,
    "F": None,
    "I": None,
    "D": None,
    "B_age": None,
    "B_language": None,
    "FIN": None
}

COUNTIES = {
    "RIVERSIDE": "Riverside",
    "SAN BERNARDINO": "San Bernardino"
}

FIPS = {
    "06065": "Riverside",
    "06071": "San Bernardino"
}

log = []

def status(source, result):
    log.append({"source": source, "status": result})
    print(source, "-", result)

def pick(key, patterns):
    if FILES[key]:
        p = Path(FILES[key]).expanduser()
        if not p.exists():
            raise FileNotFoundError(p)
        return p
    for pattern in patterns:
        matches = sorted(ROOT.glob(pattern))
        if matches:
            return matches[0]
    return None

def csv(path):
    try:
        return pd.read_csv(
            path, dtype=str, keep_default_na=False,
            encoding="utf-8-sig", low_memory=False
        )
    except UnicodeDecodeError:
        return pd.read_csv(
            path, dtype=str, keep_default_na=False,
            encoding="cp1252", low_memory=False
        )

def npi(x):
    if pd.isna(x):
        return ""
    s = str(x).strip()
    if re.fullmatch(r"\d{10}\.0+", s):
        s = s.split(".")[0]
    if re.fullmatch(r"[\d.]+[eE][+-]?\d+", s):
        try:
            from decimal import Decimal
            val = Decimal(s)
            s = str(int(val)) if val == val.to_integral_value() else ""
        except Exception:
            s = ""
    return s if re.fullmatch(r"\d{10}", s) else ""

def valid_npi(s):
    if not re.fullmatch(r"\d{10}", s):
        return False
    d = [int(x) for x in "80840" + s]
    total = sum(
        (2*v//10 + 2*v%10) if j % 2 else v
        for j, v in enumerate(reversed(d))
    )
    return total % 10 == 0

def zip5(s):
    return (
        s.fillna("").astype(str)
        .str.extract(r"(\d{5})", expand=False).fillna("")
    )

def numeric(s):
    return pd.to_numeric(
        s.astype(str).str.replace(",", "", regex=False)
        .replace({"": "", "*": "", "-": ""}),
        errors="coerce"
    )

# ============================================================
# 2. SOURCE E — FFS PROVIDERS
# ============================================================

if "providers_df" in globals():
    raw = providers_df.copy()
else:
    parts = sorted(ROOT.glob(
        "**/medi-cal-ffs-provider-listing_10_26_26_PART*.csv"
    ))
    if len(parts) != 2:
        raise FileNotFoundError(
            "Upload both Source E CSV parts or run the "
            "existing Source E loading cells first."
        )
    raw = pd.concat([
        pd.read_csv(
            p, encoding="cp1252",
            low_memory=False, keep_default_na=False
        ) for p in parts
    ], ignore_index=True)

need = {
    "NPI", "State", "CountyName", "ZIP",
    "FI_Provider_Type", "FI_Provider_Specialty",
    "Legal_Name", "Address", "City"
}

if need - set(raw.columns):
    raise ValueError(
        "Source E missing columns: " + str(need - set(raw.columns))
    )

e = raw.copy()
for c in need:
    e[c] = e[c].fillna("").astype(str).str.strip()

e["npi"] = e.NPI.map(npi)
e["npi_ok"] = e.npi.map(valid_npi)

e["county"] = (
    e.CountyName.str.upper()
    .str.replace(" COUNTY", "", regex=False)
    .str.strip().map(COUNTIES)
)

e["zip"] = zip5(e.ZIP)

# Statewide FFS identifiers
e_all_npis = set(e.loc[e.npi_ok, "npi"])

# Restrict to Riverside and San Bernardino
e = e.loc[
    e.State.str.upper().eq("CA") & e.county.notna()
].copy()

e.loc[
    ~e.npi_ok | ~e.zip.str.fullmatch(r"\d{5}")
].to_csv(OUT / "E_records_to_review.csv", index=False)

e = e.loc[
    e.npi_ok & e.zip.str.fullmatch(r"\d{5}")
].copy()

e["type"] = e.FI_Provider_Type
e["specialty"] = e.FI_Provider_Specialty
e["name"] = e.Legal_Name
e["city"] = e.City
e["address"] = e.Address

# Preliminary analytical categories; retain original specialty too.
def category(row):
    s = (row["type"] + " " + row["specialty"]).lower()

    if any(t in s for t in [
        "psychiatr", "psycholog", "behavior",
        "mental health", "counsel", "social work",
        "marriage and family"
    ]):
        return "Mental health (candidate)"

    if any(t in s for t in [
        "dental", "dentist", "orthodont"
    ]):
        return "Dental (E; use F for complete dental)"

    if any(t in s for t in [
        "family practice", "general practice",
        "internal medicine", "pediatrics", "primary care"
    ]):
        return "Primary care (candidate)"

    if any(t in s for t in [
        "physician", "surgeon", "cardiolog",
        "neurolog", "dermatolog"
    ]):
        return "Specialist/physician (candidate)"

    return "Other/unspecified"

e["service"] = e.apply(category, axis=1)

# Keep different practice sites and specialties.
e["site"] = (
    e.npi + "|" + e.county + "|" + e.zip + "|"
    + e.address.str.upper().str.replace(
        r"\s+", " ", regex=True
    )
)

e = e.drop_duplicates(
    ["site", "type", "specialty"]
).copy()

e[[
    "npi", "name", "county", "city", "zip",
    "address", "type", "specialty", "service", "site"
]].to_csv(
    OUT / "01_E_FFS_provider_list.csv",
    index=False
)

supply = e.groupby(
    ["county", "zip", "service"], as_index=False
).agg(
    ffs_npis=("npi", "nunique"),
    ffs_sites=("site", "nunique")
)

supply.to_csv(
    OUT / "02_E_FFS_supply_by_ZIP_specialty.csv",
    index=False
)

status(
    "E",
    f"READY: {e.npi.nunique():,} distinct FFS NPIs "
    "in Riverside/San Bernardino"
)

# ============================================================
# 3. IEHP DIRECTORY — PROVIDER OVERLAP
# ============================================================

ifile = pick("I", [
    "IEHP_FINAL_4_CSVs/01_IEHP_providers_Riverside_San_Bernardino.csv",
    "IEHP_PDF_FFS_Export/07_UNIQUE_IEHP_PROVIDERS_DEDUPED_BY_NPI.csv",
    "data/*IEHP*provider*.csv",
    "**/IEHP_provider_directory_extracted.csv"
])

if ifile:
    i = csv(ifile)

    column = next(
        (c for c in ["npi", "npi_as_printed", "NPI"]
         if c in i),
        None
    )

    if not column:
        raise ValueError("IEHP CSV needs an NPI column.")

    i["npi"] = i[column].map(npi)
    i = i[i.npi.map(valid_npi)].copy()

    local_ffs = set(e.npi)
    iehp = set(i.npi)

    i["ffs_statewide_match"] = i.npi.isin(e_all_npis)
    i["ffs_local_match"] = i.npi.isin(local_ffs)

    i.to_csv(
        OUT / "03_I_IEHP_providers_FFS_flags.csv",
