# 10. INTERACTIVE FILTERING, RANKING & EXPORT BUTTONS
# ============================================================

try:
    import ipywidgets as w
    from IPython.display import clear_output

    table = access if access is not None else supply

    county = w.Dropdown(
        options=["All", "Riverside", "San Bernardino"],
        description="County:"
    )

    service = w.Dropdown(
        options=["All"] + sorted(table.service.unique()),
        description="Service:"
    )

    zip_input = w.Text(
        description="ZIP:",
        placeholder="Optional"
    )

    options = [
        ("Fewest FFS providers", "fewest"),
        ("Most FFS providers", "most")
    ]

    if access is not None:
        options += [
            ("Highest potential access risk", "risk"),
            ("Most members", "members")
        ]

    ranking = w.Dropdown(
        options=options,
        description="Rank:"
    )

    top = w.Dropdown(
        options=[10, 25, 50, 100, 0],
        description="Top:",
        value=10
    )

    run_button = w.Button(
        description="Filter & Rank",
        button_style="primary"
    )

    save_button = w.Button(
        description="Export displayed CSV"
    )

    output = w.Output()
    selected = {"data": pd.DataFrame()}

    def run_filter(_=None):
        t = table.copy()

        if county.value != "All":
            t = t[t.county.eq(county.value)]

        if service.value != "All":
            t = t[t.service.eq(service.value)]

        if zip_input.value.strip():
            t = t[t.zip.eq(zip_input.value.strip())]

        if ranking.value == "risk":
            t = (
                t[t.usable_for_ranking]
                .sort_values(
                    [
                        "zero_ffs_listed",
                        "providers_per_1000",
                        "medi_cal_members_est"
                    ],
                    ascending=[False, True, False]
                )
            )

        elif ranking.value == "members":
            t = t.sort_values(
                "medi_cal_members_est",
                ascending=False
            )

        else:
            t = t.sort_values(
                "ffs_npis",
                ascending=(ranking.value == "fewest")
            )

        if top.value:
            t = t.head(top.value)

        selected["data"] = t

        with output:
            clear_output(wait=True)
            print("Results:", len(t))
            print(
                "FFS enrollment does not guarantee "
                "appointment availability."
            )
            display(t.head(100))

    def export_filter(_):
        if selected["data"].empty:
            run_filter()

        path = OUT / "14_CUSTOM_FILTERED_RESULTS.csv"

        selected["data"].to_csv(
            path, index=False
        )

        with output:
            print("Saved:", path)

    run_button.on_click(run_filter)
    save_button.on_click(export_filter)

    display(w.VBox([
        w.HTML("<b>IEHP Provider and Access Ranking</b>"),
        w.HBox([county, service]),
        w.HBox([zip_input, ranking, top]),
        w.HBox([run_button, save_button]),
        output
    ]))

    run_filter()

except ImportError:
    print(
        "For interactive buttons, install ipywidgets: "
        "%pip install ipywidgets"
    )
